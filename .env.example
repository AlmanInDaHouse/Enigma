# ─── Enigma — Variables de entorno ────────────────────────────
# Copiar este fichero a `.env` y rellenar valores reales.
# NO commitear `.env`.

# ─── Paths (usar forward slashes en Windows) ──────────────────
ENIGMA_VAULT_PATH=C:/Users/manul/Enigma_V3/vault
ENIGMA_DATA_PATH=C:/Users/manul/Enigma_V3/data

# ─── Ollama (LLM y embeddings locales) ────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# ─── Qdrant (base vectorial) ──────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=enigma_notes
QDRANT_API_KEY=

# ─── Whisper (transcripción) ──────────────────────────────────
# Modelos: tiny | base | small | medium | large-v3
WHISPER_MODEL=large-v3
# Device: cpu | cuda | auto
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=es
WHISPER_COMPUTE_TYPE=int8   # int8 | float16 | float32

# ─── Diarización ──────────────────────────────────────────────
DIARIZATION_ENABLED=true
PYANNOTE_AUTH_TOKEN=         # token de HuggingFace para pyannote (gratis)

# ─── API ──────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8077
API_LOG_LEVEL=info

# ─── Comportamiento del extractor ─────────────────────────────
EXTRACT_CHUNK_TOKENS=1500
EXTRACT_CHUNK_OVERLAP=200
EXTRACT_MAX_NOTES_PER_CALL=50

# ─── Linker (creación automática de wikilinks) ────────────────
LINK_SIMILARITY_THRESHOLD=0.78
LINK_TOP_K_CANDIDATES=5
LINK_LLM_VALIDATION=true

# ─── Deduplicación ────────────────────────────────────────────
DEDUP_SIMILARITY_THRESHOLD=0.92

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json   # json | console

# ─── Modo desarrollo ──────────────────────────────────────────
DEV_MODE=false
